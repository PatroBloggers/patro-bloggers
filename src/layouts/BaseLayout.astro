---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import { url } from '../lib/utils';

interface Props {
  title?: string;
  description?: string;
  /** Imagen para compartir (ruta del sitio o URL); por defecto, la genérica con el escudo */
  image?: string;
  /** `article` en la página de un trabajo */
  type?: 'website' | 'article';
}

const siteName = 'Patro Bloggers';
// Imagen genérica (plantilla en scripts/og-image.html). Subir ?v= al cambiarla: WhatsApp y
// las demás apps guardan la vista previa y, si la dirección no cambia, siguen enseñando la antigua
const defaultImage = url('og-image.png?v=2');
const {
  title,
  description = 'Redacciones, relatos y reflexiones del alumnado, publicados con pseudónimo.',
  image = defaultImage,
  type = 'website',
} = Astro.props;
const pageTitle = title ? `${title} · ${siteName}` : siteName;
// Las redes sociales necesitan URLs absolutas
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <!-- Trabajos de menores: que los buscadores no indexen la web ni sus imágenes. (Un robots.txt
         no serviría: tendría que estar en la raíz del dominio, fuera de /patro-bloggers/) -->
    <meta name="robots" content="noindex, nofollow, noimageindex" />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <!-- Instalable como aplicación (PWA / WebAPK en Android) -->
    <link rel="manifest" href={url('manifest.webmanifest')} />
    <meta name="theme-color" content="#004888" />
    <meta name="generator" content={Astro.generator} />

    <!-- Vista previa al compartir (WhatsApp, Teams, Classroom...) -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title ?? siteName} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    {
      // Con el tamaño, WhatsApp muestra la vista previa grande desde el primer momento
      image === defaultImage && (
        <>
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content="Escudo de Patro Bloggers" />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />

    <title>{pageTitle}</title>
    <script is:inline>
      // Aplica el tema antes de pintar para evitar un destello del tema equivocado
      (() => {
        let theme = null;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="site-brand" href={url()}>
          <img src={url('logo.svg')} width="64" height="72" alt="" />
          <span>{siteName}</span>
        </a>
        <ThemeToggle />
      </div>
    </header>
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">Trabajos publicados con pseudónimo · {new Date().getFullYear()}</div>
    </footer>
    {
      import.meta.env.PROD && (
        <script is:inline define:vars={{ swUrl: url('sw.js'), scope: url() }}>
          if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => navigator.serviceWorker.register(swUrl, { scope }));
          }
        </script>
      )
    }
  </body>
</html>
