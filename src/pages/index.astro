---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrabajoList from '../components/TrabajoList.astro';
import { getTrabajos } from '../lib/utils';

const trabajos = await getTrabajos();
---

<BaseLayout>
  <section class="intro">
    <h1>Trabajos del alumnado</h1>
    <p>Una selección de textos escritos por nuestros alumnos y alumnas.</p>
  </section>
  <TrabajoList trabajos={trabajos} />
</BaseLayout>
