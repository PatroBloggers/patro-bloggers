---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrabajosExplorer from '../components/TrabajosExplorer';
import { SUBJECTS } from '../lib/subjects';
import { getTrabajos, toTrabajoItem, url } from '../lib/utils';

const items = await Promise.all((await getTrabajos()).map(toTrabajoItem));
---

<BaseLayout>
  <section class="intro hero">
    <img class="hero-logo" src={url('logo.svg')} width="140" height="157" alt="Escudo de Patro Bloggers" />
    <div>
      <h1>Bienvenidos a Patro Bloggers</h1>
      <p>
        Este es el rincón donde nuestro alumnado comparte lo que escribe: redacciones, relatos, ensayos y
        reflexiones nacidos en clase y fuera de ella. Cada trabajo se publica con un pseudónimo, porque aquí lo
        importante son las ideas. Pasa, lee y déjate sorprender.
      </p>
    </div>
  </section>
  <TrabajosExplorer client:load items={items} subjects={SUBJECTS} />
</BaseLayout>
