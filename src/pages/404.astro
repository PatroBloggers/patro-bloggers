---
import BaseLayout from '../layouts/BaseLayout.astro';
import ConfusedDove from '../components/ConfusedDove.astro';
import { url } from '../lib/utils';
---

<BaseLayout title="Página no encontrada">
  <section class="not-found">
    <ConfusedDove />
    <p class="not-found-code">Error 404</p>
    <h1>¡Vaya! Esta página se ha perdido</h1>
    <p>
      Nuestra paloma ha buscado por todas partes, pero aquí no hay nada. Puede que el enlace esté mal escrito
      o que el trabajo ya no exista.
    </p>
    <a class="button" href={url()}>Volver a la portada</a>
  </section>
</BaseLayout>
