---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrabajoList from '../../components/TrabajoList.astro';
import { getTrabajos, slugify, url } from '../../lib/utils';

export async function getStaticPaths() {
  const trabajos = await getTrabajos();
  // Agrupa por slug para que "Redacción" y "redaccion" compartan página
  const byTag = new Map<string, { label: string; trabajos: typeof trabajos }>();
  for (const trabajo of trabajos) {
    for (const tag of trabajo.data.tags) {
      const slug = slugify(tag);
      if (!byTag.has(slug)) byTag.set(slug, { label: tag, trabajos: [] });
      byTag.get(slug)!.trabajos.push(trabajo);
    }
  }
  return [...byTag].map(([tag, props]) => ({ params: { tag }, props }));
}

const { label, trabajos } = Astro.props;
---

<BaseLayout title={`#${label}`}>
  <section class="intro">
    <a class="back" href={url()}>← Todos los trabajos</a>
    <h1>#{label}</h1>
  </section>
  <TrabajoList trabajos={trabajos} />
</BaseLayout>
