---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrintButton from '../../components/PrintButton.astro';
import ShareButton from '../../components/ShareButton.astro';
import TagList from '../../components/TagList.astro';
import { courseOf } from '../../lib/courses';
import { excerpt, formatDate, getTrabajos, readingMinutes, shareImage, url } from '../../lib/utils';

export async function getStaticPaths() {
  const trabajos = await getTrabajos();
  // Ordenados del más reciente al más antiguo: el anterior es el siguiente en la lista
  return trabajos.map((trabajo, i) => ({
    params: { slug: trabajo.id },
    props: { trabajo, older: trabajos[i + 1], newer: trabajos[i - 1] },
  }));
}

const { trabajo, older, newer } = Astro.props;
const { title, author, date, subject, image, tags } = trabajo.data;
const { Content } = await render(trabajo);
const minutes = readingMinutes(trabajo.body);
const course = courseOf(date);
const canonicalUrl = new URL(url(`trabajos/${trabajo.id}/`), Astro.site);
---

<BaseLayout
  title={title}
  description={`${author}: ${excerpt(trabajo.body)}`}
  image={image ? await shareImage(image) : undefined}
  type="article"
>
  <article class="trabajo">
    <p class="print-only print-brand">
      <img src={url('logo.svg')} width="28" height="31" alt="" /> Patro Bloggers
    </p>
    <a class="back" href={url()}>← Todos los trabajos</a>
    <header>
      <p class="kicker">
        {subject && <span class="subject">{subject}</span>}
        {subject && ' · '}
        <a href={url(`?curso=${course.slug}`)}>{subject ? course.years : course.label}</a>
      </p>
      <h1>{title}</h1>
      <p class="meta">
        {author} · <time datetime={date.toISOString()}>{formatDate(date)}</time> · {minutes} min de lectura
      </p>
      <div class="trabajo-actions">
        <TagList tags={tags} />
        <div class="trabajo-buttons">
          <ShareButton title={title} author={author} href={url(`trabajos/${trabajo.id}`)} />
          <PrintButton />
        </div>
      </div>
    </header>
    {
      image && (
        <Image
          class="trabajo-image"
          src={image}
          width={700}
          sizes="(max-width: 732px) 100vw, 700px"
          format="webp"
          alt=""
          loading="eager"
        />
      )
    }
    <div class="prose">
      <Content />
    </div>
    <p class="print-only print-source">Publicado en Patro Bloggers · {canonicalUrl.href}</p>
    {
      (older || newer) && (
        <nav class="trabajo-nav" aria-label="Más trabajos">
          {older && (
            <a class="trabajo-nav-link" href={url(`trabajos/${older.id}`)} rel="prev" title="Trabajo anterior">
              ← <span>{older.data.title}</span>
            </a>
          )}
          {newer && (
            <a class="trabajo-nav-link trabajo-nav-next" href={url(`trabajos/${newer.id}`)} rel="next" title="Trabajo siguiente">
              <span>{newer.data.title}</span> →
            </a>
          )}
        </nav>
      )
    }
  </article>
</BaseLayout>
