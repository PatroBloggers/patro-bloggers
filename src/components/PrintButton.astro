---
// Abre el diálogo de impresión del navegador, desde el que también se puede guardar como PDF
---

<button type="button" class="icon-button print-button" aria-label="Imprimir o guardar como PDF" title="Imprimir / PDF">
  <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M6 9V3h12v6"></path>
    <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
    <path d="M6 14h12v7H6z"></path>
  </svg>
</button>

<script>
  document.querySelector('.print-button')?.addEventListener('click', () => window.print());

  // Las imágenes del texto se cargan al hacer scroll; al imprimir (también con Ctrl+P) hacen falta todas
  window.addEventListener('beforeprint', () => {
    document.querySelectorAll<HTMLImageElement>('img[loading="lazy"]').forEach((img) => (img.loading = 'eager'));
  });
</script>
