---
import { slugify, url } from '../lib/utils';

interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="tags">
      {tags.map((tag) => (
        <li>
          <a class="tag" href={url(`?tag=${slugify(tag)}`)}>#{tag}</a>
        </li>
      ))}
    </ul>
  )
}
